# ============================================
# AI Travel Planner - Environment Configuration
# ============================================
# Copy this file to `.env` and fill in your values.
# Never commit the real `.env` file.

# --- Application ---
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# --- API ---
API_V1_PREFIX=/api/v1

# --- Database ---
# Local development without Docker:
#   DATABASE_URL=sqlite:///./travel.db
# Local development with Docker (PostgreSQL on localhost:5432):
#   DATABASE_URL=postgresql+psycopg://travel:travel@localhost:5432/travel_db
# Docker Compose (service name `db`):
#   DATABASE_URL=postgresql+psycopg://travel:travel@db:5432/travel_db
DATABASE_URL=postgresql+psycopg://travel:travel@localhost:5432/travel_db

# --- LLM ---
# Option 1: OpenAI
#   LLM_PROVIDER=openai
#   MODEL_NAME=gpt-4.1-mini
#   OPENAI_API_KEY=your-openai-key
#   OPENAI_BASE_URL=
# Option 2: Groq (free tier, via OpenAI-compatible endpoint)
LLM_PROVIDER=openai
MODEL_NAME=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# --- PostgreSQL (Docker Compose only) ---
POSTGRES_USER=travel
POSTGRES_PASSWORD=travel
POSTGRES_DB=travel_db
POSTGRES_PORT=5432
