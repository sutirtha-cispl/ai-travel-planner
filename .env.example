# ============================================
# AI Travel Planner - Environment Configuration
# ============================================
# Copy this file to `.env` and fill in your values.
# Never commit the real `.env` file.

# --- Application ---
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# --- API ---
API_V1_PREFIX=/api/v1

# --- Database ---
# Local development without Docker:
#   DATABASE_URL=sqlite:///./travel.db
# Local development with Docker (PostgreSQL on localhost:5432):
#   DATABASE_URL=postgresql+psycopg://travel:travel@localhost:5432/travel_db
# Docker Compose (service name `db`):
#   DATABASE_URL=postgresql+psycopg://travel:travel@db:5432/travel_db
DATABASE_URL=postgresql+psycopg://travel:travel@localhost:5432/travel_db

# --- LLM (used in later sprints, no AI agents implemented yet) ---
LLM_PROVIDER=openai
MODEL_NAME=gpt-4.1-mini
OPENAI_API_KEY=

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# --- PostgreSQL (Docker Compose only) ---
POSTGRES_USER=travel
POSTGRES_PASSWORD=travel
POSTGRES_DB=travel_db
POSTGRES_PORT=5432
